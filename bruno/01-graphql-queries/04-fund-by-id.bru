meta {
  name: Fund by ID
  type: http
  seq: 4
}

post {
  url: {{gatewayUrl}}/graphql
  body: graphql
  auth: none
}

headers {
  Content-Type: application/json
}

body:graphql {
  query FundDetail($id: String!) {
    fund(id: $id) {
      id
      name
      isin
      assetClass
      currency
      riskRating
      ongoingChargePercent
      oneYearReturnPercent
      sustainabilityLabel
    }
  }
}

body:graphql:vars {
  {
    "id": "fund-global-equity"
  }
}

docs {
  Funds GET /funds/{id}.

  Use this to prove invalidation is targeted. Run it, then purge
  Account acct-1001. This response survives, because it carries only a
  Fund tag and no Account tag.

  Fund has the longest TTL (300s) since reference data rarely changes.
}
