meta {
  name: List funds
  type: http
  seq: 7
}

post {
  url: {{gatewayUrl}}/graphql
  body: graphql
  auth: none
}

headers {
  Content-Type: application/json
}

body:graphql {
  query ListFunds {
    funds {
      id
      name
      isin
      assetClass
      riskRating
      ongoingChargePercent
      sustainabilityLabel
    }
  }
}

docs {
  Funds GET /funds.

  Note fundsByAccount(accountId:) exists in the schema but its REST route
  (GET /accounts/{accountId}/funds) crashes the funds mock service. Do not call
  it until mock-rest-apis/funds/server.js:135 is fixed.
}
