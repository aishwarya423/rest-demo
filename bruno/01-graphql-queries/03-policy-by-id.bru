meta {
  name: Policy by ID (reverse join to Account)
  type: http
  seq: 3
}

post {
  url: {{gatewayUrl}}/graphql
  body: graphql
  auth: none
}

headers {
  Content-Type: application/json
}

body:graphql {
  query PolicyWithAccount($id: String!) {
    policy(id: $id) {
      id
      policyNumber
      productName
      status
      premiumMonthly
      fundIds
      account {
        id
        holderName
        accountType
      }
    }
  }
}

body:graphql:vars {
  {
    "id": "pol-life-3001"
  }
}

docs {
  The join in the other direction: Policies GET /policies/{id}, then
  Accounts GET /accounts/{accountId}.

  Wired by the @resolveTo on Policy.account in hive-poc/mesh/mesh.config.ts.

  fundIds is the raw array from the REST payload. There is no linkedFunds field,
  because the funds service has no batch-by-ids route to fan out to.
}
