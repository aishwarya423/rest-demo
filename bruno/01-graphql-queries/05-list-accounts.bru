meta {
  name: List accounts
  type: http
  seq: 5
}

post {
  url: {{gatewayUrl}}/graphql
  body: graphql
  auth: none
}

headers {
  Content-Type: application/json
}

body:graphql {
  query ListAccounts {
    accounts {
      id
      customerId
      holderName
      accountType
      totalValue
    }
  }
}

docs {
  Accounts GET /accounts.

  This field takes no arguments. To filter by customer, use the separate
  accountsByCustomer query, which maps to GET /customers/{customerId}/accounts.

  Caution for the demo: this response is tagged with EVERY account it returns,
  so purging any one account invalidates it.
}
