meta {
  name: Account by ID
  type: http
  seq: 1
}

post {
  url: {{gatewayUrl}}/graphql
  body: graphql
  auth: none
}

headers {
  Content-Type: application/json
}

body:graphql {
  query AccountById($id: String!) {
    account(id: $id) {
      id
      holderName
      accountType
      totalValue
    }
  }
}

body:graphql:vars {
  {
    "id": "acct-1001"
  }
}

docs {
  Single REST call behind this: Accounts GET /accounts/{id}.

  Note the variable type is String!, not ID!. Mesh derives argument types from
  the OpenAPI path parameters, which are plain strings.

  First call is a cache MISS. Repeat calls inside the Account TTL (30s) are HITs
  and make no REST calls at all.

  Cache key written:
    response-cache:gql.AccountById.id-acct-1001.<documentHash>
}
