meta {
  name: Account full portfolio (3 REST services)
  type: http
  seq: 2
}

post {
  url: {{gatewayUrl}}/graphql
  body: graphql
  auth: none
}

headers {
  Content-Type: application/json
}

body:graphql {
  query AccountOverview($id: String!) {
    account(id: $id) {
      id
      holderName
      accountType
      totalValue
      policies {
        id
        policyNumber
        productName
        status
        premiumMonthly
      }
      fundHoldings {
        allocationPercent
        currentValue
        fund {
          id
          name
          isin
          assetClass
          riskRating
        }
      }
    }
  }
}

body:graphql:vars {
  {
    "id": "acct-1001"
  }
}

docs {
  THE demo query. One request, three REST services:
    account       -> Accounts  GET /accounts/{id}
    policies      -> Policies  GET /accounts/{id}/policies
    fundHoldings  -> Funds     GET /funds/{fundId}, once per holding

  This single cached response is tagged with entities from all three services:
  one Account, two Policy and three Fund tags. That is what makes per-entity
  invalidation possible.

  There is no account.funds field. Its REST route crashes the funds mock
  service, so the join runs through fundHoldings instead.
}
