meta {
  name: Policies by account
  type: http
  seq: 6
}

post {
  url: {{gatewayUrl}}/graphql
  body: graphql
  auth: none
}

headers {
  Content-Type: application/json
}

body:graphql {
  query PoliciesByAccount($accountId: String!) {
    policiesByAccount(accountId: $accountId) {
      id
      policyNumber
      productName
      policyType
      status
      sumAssured
      insuredPerson
    }
  }
}

body:graphql:vars {
  {
    "accountId": "acct-1001"
  }
}

docs {
  Policies GET /accounts/{accountId}/policies, called directly rather than
  through Account.policies.

  Also available: policiesByFund(fundId:) -> GET /funds/{fundId}/policies,
  and policies -> GET /policies for the full list.
}
