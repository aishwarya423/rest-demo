{
  "name": "rest-demo",
  "version": "1.0.0",
  "description": "Three REST APIs exposed as one unified GraphQL API via Hive Gateway, with Redis/Valkey response caching and explicit entity invalidation.",
  "scripts": {
    "mock-apis": "concurrently \"npm:mock-rest:accounts\" \"npm:mock-rest:funds\" \"npm:mock-rest:policies\"",
    "mock-rest:accounts": "cd ./mock-rest-apis/accounts && node server.js",
    "mock-rest:funds": "cd ./mock-rest-apis/funds && node server.js",
    "mock-rest:policies": "cd ./mock-rest-apis/policies && node server.js",
    "POC": "-------------HIVE POC---------------",
    "poc:up": "docker compose -f hive-poc/docker-compose.yml up --build -d",
    "poc:down": "docker compose -f hive-poc/docker-compose.yml down",
    "poc:reset": "docker compose -f hive-poc/docker-compose.yml down -v",
    "poc:logs": "docker compose -f hive-poc/docker-compose.yml logs -f hive-gateway",
    "poc:ps": "docker compose -f hive-poc/docker-compose.yml ps -a",
    "poc:demo": "cd hive-poc/demo && ./demo.sh",
    "poc:keys": "docker compose -f hive-poc/docker-compose.yml exec valkey valkey-cli --scan --pattern 'response-cache:*'",
    "COMPOSE": "-------------SUPERGRAPH---------------",
    "supergraph:build": "cd hive-poc/mesh && ACCOUNTS_URL=http://localhost:3001 POLICIES_URL=http://localhost:3003 FUNDS_URL=http://localhost:3002 npx mesh-compose -o ../supergraph.graphql"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aishwarya423/rest-demo.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/aishwarya423/rest-demo/issues"
  },
  "homepage": "https://github.com/aishwarya423/rest-demo#readme",
  "devDependencies": {
    "concurrently": "^10.0.3",
    "yaml": "^2.9.0"
  }
}
