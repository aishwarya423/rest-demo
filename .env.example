# API keys the gateway forwards to the three REST services as X-Api-Key.
# Referenced from hive-poc/mesh/mesh.config.ts as {env.*} and injected at runtime.
ACCOUNTS_API_KEY=accounts-local-key
POLICIES_API_KEY=policies-local-key
FUNDS_API_KEY=funds-local-key

# Where Hive Gateway stores cached responses.
# Inside docker compose this is the valkey service; override for an external instance.
REDIS_URL=redis://valkey:6379

# Opt in to the raw REST (HTTP-level) response cache.
# Requires the REST services to send Cache-Control headers, so it is off by default.
ENABLE_HTTP_CACHE=0

# Response TTLs are set in hive-poc/gateway/gateway.config.ts, not here:
#   Fund    -> 300s  (reference data)
#   Policy  -> 120s
#   Account -> 30s   (most volatile)
