# ===========================================================================
# hive-router-poc — environment template
# ===========================================================================
# Copy to .env and fill in, OR let the bootstrap script generate the secrets:
#
#   ./hive-console/bootstrap-secrets.sh
#
# The script is the recommended path. It writes a .env with every GENERATED
# value already resolved, because a Compose .env file does not run command
# substitution — putting $(openssl rand -hex 32) in here would store the
# literal string, not a secret.
#
# Legend
#   GENERATED  bootstrap-secrets.sh produces it; any random value works
#   FIXED      safe to leave at the value shown
#   MANUAL     you must supply it yourself from the Hive Console UI
# ===========================================================================


# ---------------------------------------------------------------------------
# Hive release                                                         [FIXED]
# ---------------------------------------------------------------------------
# The vendored Compose file and the images must come from the SAME release.
# hive-console/docker-compose.community.yml is pinned to hive@15.0.1; if you
# re-fetch it for another release, change DOCKER_TAG to match.
# The trailing slash on DOCKER_REGISTRY and the leading colon on DOCKER_TAG
# are both required — the Compose file concatenates them around the image name.
HIVE_VERSION=15.0.1
DOCKER_REGISTRY=ghcr.io/graphql-hive/
DOCKER_TAG=:15.0.1

# ---------------------------------------------------------------------------
# Public URL of the Console web app                                    [FIXED]
# ---------------------------------------------------------------------------
# Local only. For a remote deployment this is NOT sufficient on its own: the
# GraphQL, subscription and artifact URLs in the vendored Compose file are also
# hard-coded to localhost and would each need an override.
HIVE_APP_BASE_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# PostgreSQL — organizations, projects, targets, schema versions, checks
# ---------------------------------------------------------------------------
POSTGRES_DB=registry
POSTGRES_USER=postgres
POSTGRES_PASSWORD=                      # [GENERATED] openssl rand -hex 32

# ---------------------------------------------------------------------------
# ClickHouse — GraphQL operation usage data
# ---------------------------------------------------------------------------
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=                    # [GENERATED] openssl rand -hex 32

# ---------------------------------------------------------------------------
# Redis — Hive's own cache
# ---------------------------------------------------------------------------
# Note this is NOT the POC's Valkey on :6379. Hive runs its own Redis on the
# `hive` network with no published port; the two never meet.
REDIS_PASSWORD=                         # [GENERATED] openssl rand -hex 32

# ---------------------------------------------------------------------------
# S3-compatible storage — schema artifacts and audit logs
# ---------------------------------------------------------------------------
# hive@15 uses VersityGW rather than MinIO, and RENAMED these two variables
# from MINIO_ROOT_USER / MINIO_ROOT_PASSWORD. The published get-started guide
# still shows the MINIO_* names. With hive@15 those names are simply ignored,
# the S3 credentials resolve empty, and artifact storage fails at runtime
# rather than at startup. Use the S3_* names below.
S3_ROOT_USER=hiveadmin
S3_ROOT_PASSWORD=                       # [GENERATED] openssl rand -hex 32

# ---------------------------------------------------------------------------
# Application secrets
# ---------------------------------------------------------------------------
# ENCRYPTION_SECRET encrypts stored integration credentials.
# CDN_AUTH_PRIVATE_KEY signs the CDN access tokens you create in the UI, so
# changing it invalidates every CDN token already issued.
HIVE_ENCRYPTION_SECRET=                 # [GENERATED] openssl rand -hex 16
CDN_AUTH_PRIVATE_KEY=                   # [GENERATED] openssl rand -hex 32

# Session keys for Hive's native auth. The SUPERTOKENS_ prefix is historical —
# the current stack does not run a separate SuperTokens service.
#   REFRESH: 1000:<openssl rand -hex 64>:<openssl rand -hex 64>
#   ACCESS : <key-id>|<base64 RSA public body>|<base64 RSA private body>
#            i.e. a 2048-bit RSA PEM pair with headers, footers and newlines
#            stripped. bootstrap-secrets.sh builds this for you.
# Quote both: they contain ':' and '|'.
SUPERTOKENS_REFRESH_TOKEN_KEY=''        # [GENERATED]
SUPERTOKENS_ACCESS_TOKEN_KEY=''         # [GENERATED]

# ---------------------------------------------------------------------------
# Logging                                                              [FIXED]
# ---------------------------------------------------------------------------
# The vendored Compose file defaults every Hive service to `debug`, which is
# very loud across 14 containers. `info` is plenty for a working stack.
LOG_LEVEL=info

# ===========================================================================
# POC settings — unchanged from the original hive-router-poc          [FIXED]
# ===========================================================================
ACCOUNTS_API_KEY=accounts-local-key
POLICIES_API_KEY=policies-local-key
FUNDS_API_KEY=funds-local-key
CACHE_ENABLED=1
CACHE_EXTENSION_METADATA=1
ACCOUNTS_TTL_MS=30000
POLICIES_TTL_MS=120000
FUNDS_TTL_MS=300000

# ===========================================================================
# MANUAL — created in the Console UI, after the stack is up
# ===========================================================================
# Nothing can generate these: they are issued by Hive Console once you have an
# account, an organization, a project and a target. See README step 4 and 5.
#
# HIVE_TOKEN
#   Target -> Settings -> Access Tokens -> Create.
#   Needs at least "Publish schema" and "Check schema" on the target.
#   Used by hive/publish.sh and hive/check.sh.
HIVE_TARGET=
HIVE_TOKEN=

# HIVE_CDN_ENDPOINT / HIVE_CDN_KEY
#   Target -> Connect to CDN.
#   Self-hosted there is no real CDN: the High-Availability CDN is a Hive Cloud
#   feature. The same artifact routes are served by the `server` container,
#   which the vendored Compose file already enables with CDN_API=1.
#
#   The UI shows the localhost form. The router runs in a container, so it
#   needs the IN-NETWORK form — same target id, different host:
#     router (in-network) : http://server:3001/artifacts/v1/<TARGET_ID>
#     your shell          : http://localhost:8082/artifacts/v1/<TARGET_ID>
HIVE_CDN_ENDPOINT=
HIVE_CDN_KEY=
