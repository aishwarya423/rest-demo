# The local Hive Console account created during first-run setup.
hive-console/.local-dev-account

# Hive Console's persistent state: PostgreSQL, ClickHouse, Redpanda, Redis and
# the S3 artifact store. Deleting this directory resets the installation.
hive-console/.hive/
